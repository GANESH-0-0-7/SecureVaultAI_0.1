# Local development defaults. The applications have safe local defaults;
# no real credentials or secrets belong in this file.
APP_NAME=secure-cloud-file-sharing
APP_ENV=development
VITE_APP_NAME=secure-cloud-file-sharing
VITE_API_BASE_URL=http://localhost:8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIRECTORY=./.data/files

# PostgreSQL production examples: set these in a secret manager / environment.
# Never commit the populated values.
# SPRING_PROFILES_ACTIVE=prod
# APP_JWT_SECRET=<generate-a-unique-random-secret-of-at-least-32-characters>
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/secure_cloud_files?sslmode=require
# SPRING_DATASOURCE_USERNAME=<database-user>
# SPRING_DATASOURCE_PASSWORD=<database-password>
# STORAGE_PROVIDER=database
# MIGRATE_LOCAL_DATA=false
#
# To migrate the existing local H2 database and encrypted files on the first
# PostgreSQL startup, temporarily set MIGRATE_LOCAL_DATA=true. The migration
# fails safely if the target tables are not empty or a local ciphertext file
# is missing. It does not delete or alter the local source data.
#
# Optional external object storage instead of database-backed ciphertext:
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<backend-only-service-role-key>
# SUPABASE_BUCKET=encrypted-files
